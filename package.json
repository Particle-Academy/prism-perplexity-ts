{
  "name": "@particle-academy/prism-perplexity",
  "version": "0.1.0",
  "description": "Perplexity's search, embeddings and Agent API for TypeScript.",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
